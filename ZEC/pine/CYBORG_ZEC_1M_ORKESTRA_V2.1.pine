var array<bool> M_E2_P04_S = toArr("001000000000000000000000000000000010000000000101001000000000000001000000101100000100100010001000")
var array<bool> M_E2_P08_L = toArr("000000000010000000000000011000100000000000001011000010000000000000000000101100010000000000000000")
