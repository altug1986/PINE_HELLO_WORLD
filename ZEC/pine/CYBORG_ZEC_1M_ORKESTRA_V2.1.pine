int L0 = kural(M_E0_P04_L, vP04, 1) + kural(M_E0_P08_L, vP08, 1) + kural(M_E0_P09_L, vP09, 1) + kural(M_E0_P10_L, vP10, 1) + kural(M_E0_P15_L, vP15, 1) + kural(M_E0_P11_L, vP11, 1) + kural(M_E0_P12_L, vP12, 1) + kural(M_E0_X17_L, vX17, 1)
int S0 = kural(M_E0_P04_S, vP04, -1) + kural(M_E0_P08_S, vP08, -1) + kural(M_E0_P09_S, vP09, -1) + kural(M_E0_P10_S, vP10, -1) + kural(M_E0_P15_S, vP15, -1) + kural(M_E0_P11_S, vP11, -1) + kural(M_E0_P12_S, vP12, -1) + kural(M_E0_X17_S, vX17, -1)
int L1 = kural(M_E1_P04_L, vP04, 1) + kural(M_E1_P08_L, vP08, 1) + kural(M_E1_P09_L, vP09, 1) + kural(M_E1_P10_L, vP10, 1) + kural(M_E1_P15_L, vP15, 1) + kural(M_E1_P11_L, vP11, 1) + kural(M_E1_P12_L, vP12, 1)
int S1 = kural(M_E1_P04_S, vP04, -1) + kural(M_E1_P08_S, vP08, -1) + kural(M_E1_P09_S, vP09, -1) + kural(M_E1_P10_S, vP10, -1) + kural(M_E1_P15_S, vP15, -1) + kural(M_E1_P11_S, vP11, -1) + kural(M_E1_P12_S, vP12, -1)
int L2 = kural(M_E2_P04_L, vP04, 1) + kural(M_E2_P08_L, vP08, 1) + kural(M_E2_P09_L, vP09, 1) + kural(M_E2_P10_L, vP10, 1) + kural(M_E2_P15_L, vP15, 1) + kural(M_E2_P11_L, vP11, 1) + kural(M_E2_P12_L, vP12, 1) + kural(M_E2_X17_L, vX17, 1)
int S2 = kural(M_E2_P04_S, vP04, -1) + kural(M_E2_P08_S, vP08, -1) + kural(M_E2_P09_S, vP09, -1) + kural(M_E2_P10_S, vP10, -1) + kural(M_E2_P15_S, vP15, -1) + kural(M_E2_P11_S, vP11, -1) + kural(M_E2_X17_S, vX17, -1)
int L3 = kural(M_E3_P04_L, vP04, 1) + kural(M_E3_P08_L, vP08, 1) + kural(M_E3_P09_L, vP09, 1) + kural(M_E3_P10_L, vP10, 1) + kural(M_E3_P15_L, vP15, 1) + kural(M_E3_P11_L, vP11, 1) + kural(M_E3_P12_L, vP12, 1) + kural(M_E3_P01_L, vP01, 1) + kural(M_E3_P02_L, vP02, 1) + kural(M_E3_P03_L, vP03, 1) + kural(M_E3_P05_L, vP05, 1) + kural(M_E3_P06_L, vP06, 1) + kural(M_E3_P13_L, vP13, 1) + kural(M_E3_P14_L, vP14, 1) + kural(M_E3_X16_L, vX16, 1)
int S3 = kural(M_E3_P04_S, vP04, -1) + kural(M_E3_P08_S, vP08, -1) + kural(M_E3_P09_S, vP09, -1) + kural(M_E3_P10_S, vP10, -1) + kural(M_E3_P15_S, vP15, -1) + kural(M_E3_P11_S, vP11, -1) + kural(M_E3_P12_S, vP12, -1) + kural(M_E3_P01_S, vP01, -1) + kural(M_E3_P02_S, vP02, -1) + kural(M_E3_P03_S, vP03, -1) + kural(M_E3_P05_S, vP05, -1) + kural(M_E3_P06_S, vP06, -1) + kural(M_E3_P13_S, vP13, -1) + kural(M_E3_P14_S, vP14, -1) + kural(M_E3_X16_S, vX16, -1)

// ── Giriş izinleri: fitil (son 10 dk mum) + E0 long dikkati ───────────────────────────────────────
float Hw = ta.highest(high, 10)
float Lw = ta.lowest(low, 10)
float Ow = open[9]
float rw = math.max(Hw - Lw, 1e-9)
bool fL = (math.min(Ow, close) - Lw) / rw >= 0.4
bool fS = (Hw - math.max(Ow, close)) / rw >= 0.4
bool batUp = bat1 > ta.ema(bat1, 1440) and nz(bat1 / bat1[1440]) > 1
bool dikkatL = nz(xmr1 / xmr1[1440] - 1) >= 0.04 or batUp
bool aL0 = L0 >= 2
bool aS0 = S0 >= 2 and not aL0
bool eL0 = L0 >= 2 + (dikkatL ? 2 : 0) and fL
bool eS0 = S0 >= 2 and fS
bool aL1 = L1 >= 2
bool aS1 = S1 >= 1 and not aL1
bool eL1 = L1 >= 2 and fL
bool eS1 = S1 >= 1 and fS
bool aL2 = L2 >= 2
bool aS2 = S2 >= 1 and not aL2
bool eL2 = L2 >= 2
bool eS2 = S2 >= 1
bool aL3 = L3 >= 2
bool aS3 = S3 >= 2 and not aL3
bool eL3 = L3 >= 2 and fL
bool eS3 = S3 >= 2 and fS

// ── ORKESTRA: öncelik, devralma, çıkış, giriş (araştırma motoru simN ile aynı sıra) ─────────────────
var int own = -1
var int ti = 0
var int noS = -1
bool spk = nz(close / close[10] - 1) >= 0.03
if spk
    noS := bar_index + 60
int w0 = aL0 ? 1 : (aS0 and bar_index > noS) ? -1 : 0
int w1 = aL1 ? 1 : (aS1 and bar_index > noS) ? -1 : 0
int w2 = aL2 ? 1 : (aS2 and bar_index > noS) ? -1 : 0
int w3 = aL3 ? 1 : (aS3 and bar_index > noS) ? -1 : 0
array<int> W = array.from(w0, w1, w2, w3)
array<int> THa = array.from(3840, 480, 960, 480)
array<bool> ELa = array.from(eL0, eL1, eL2, eL3)
array<bool> ESa = array.from(eS0, eS1, eS2, eS3)
int pos = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
if pos == 0
    own := -1
else if own < 0
    own := 3
bool guard = pos == -1 and spk
if pos != 0 and not guard and own > 0
    for j = 0 to own - 1
        if array.get(W, j) == pos
            own := j
            ti := bar_index
            break
bool ex = false
int blk = 0
if pos != 0
    bool tout = bar_index - ti >= array.get(THa, own)
    bool opp = false
    for j = 0 to own
        int wj = array.get(W, j)
        if wj != 0 and wj != pos
            opp := true
    ex := guard or opp or tout
    blk := tout and array.get(W, own) == pos ? pos : 0
if ex
    strategy.close_all(comment = "EXIT-ALL_BINANCE_ZECUSDT_ZEC-1M-CYBORG_1M_BOTKODU")
    pos := 0
    own := -1
if pos != 0 and array.get(W, own) == pos
    ti := bar_index
if pos == 0 and not na(atr)
    for k = 0 to 3
        int wk = array.get(W, k)
        bool izin = wk == 1 ? array.get(ELa, k) : wk == -1 ? array.get(ESa, k) : false
        bool ustTers = false   // [REV-04] üst motor ters yön istiyorsa girme
        if k > 0
            for jj = 0 to k - 1
                int wu = array.get(W, jj)
                if wu != 0 and wu != wk
                    ustTers := true
        if not ustTers and wk != 0 and wk != blk and izin
            float ep = close + syminfo.mintick * wk
            own := k
            ti := bar_index
            if wk == 1
                strategy.entry("L", strategy.long, comment = "ENTER-LONG_BINANCE_ZECUSDT_ZEC-1M-CYBORG_1M_BOTKODU")
                strategy.exit("SL-L", from_entry = "L", stop = ep - TS * atr, comment = "EXIT-ALL_BINANCE_ZECUSDT_ZEC-1M-CYBORG_1M_BOTKODU")
            else
                strategy.entry("S", strategy.short, comment = "ENTER-SHORT_BINANCE_ZECUSDT_ZEC-1M-CYBORG_1M_BOTKODU")
                strategy.exit("SL-S", from_entry = "S", stop = ep + TS * atr, comment = "EXIT-ALL_BINANCE_ZECUSDT_ZEC-1M-CYBORG_1M_BOTKODU")
            break

plot(own, "Sahip motor", color.gray, display = display.data_window)
plot(rc, "Rejim hücresi", color.gray, display = display.data_window)
plot(L0 - S0, "E0 oy farkı", color.blue, display = display.data_window)
