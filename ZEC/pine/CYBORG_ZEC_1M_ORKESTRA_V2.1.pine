//@version=6
// ═══════════════════════════════════════════════════════════════════════════════════════════════
// CYBORG | ZEC 1M ORKESTRA V2.1  —  BINANCE:ZECUSDT.P, 1 dakika
// REV-04 (2026-11-25): GİRİŞ-ÇIKIŞ ZİNCİRİ DÜZELTMESİ — daha öncelikli motor ters yön istiyorsa alt motor giremez
//   (V2.0'da alt motor girip bir sonraki barda üst motorun ters oyuyla kapanıyordu: 316 tek barlık işlem).
//   Hız: 240/1.440 barlık standart sapmalar kayan toplamla (aynı sonuç, örneklem std).
//   Motor: V2.0 8.740 $ / 2.557 işlem / MaxDD 391 / DD P99 314 → V2.1 8.883 $ / 2.274 işlem / MaxDD 387 / DD P99 308 / PF 1,54 / Sharpe 2,46 / Calmar 3,90
//   tek barlık işlem 316 → 43 · 12 ay ileri DD P95/P99 590/712 · stres 7.116 · yıllar 2021 +2.201 · 2022 +2.316 · 2023 −34 · 2024 +1.032 · 2025 +2.535 · 2026 +832
//   TV penceresi (2023-02-06→) beklenen 4.346 $ / 1.495 işlem. TV'de DOĞRULANMADI.
// REV-03 (2026-11-25): ORKESTRA — tek 500 $ birimde öncelik sıralı 4 motor (V1.1 çatısı üzerine).
//   E0 ana (fiyat+OI+basis, 8 s ufuk, dikkat+fitil) > E1 hızlı (fiyat+OI, 2 s) > E2 (fiyat+OI+basis, 2 s) > E3 (geniş fiyat seti, 4 s)
//   Boşta en öncelikli izinli motor girer. Daha öncelikli motor aynı yönü isterse pozisyonu devralır, tersini isterse kapatır.
//   Yeni oylar: X17 basis (perp / BINANCE:ZECUSDT spot, 1.440 dk z) · P01 EMA40/120 · P02 Supertrend(60, 3√2) · P03 30 dk EMA20 eğimi
//               P05 Donchian 240 orta · P06 120 dk ROC/ATR · P13 BTC 60 dk · P14 XMR 60 dk · X16 mum yönlü hacim akışı 20 dk
//   Kural tabloları ZEC 2021-01→2023-12 (ilk yarı) verisinden sabitlendi (motor başına ayrı ufuk/eşik); TV'de yeniden seçim YOK.
// ARAŞTIRMA MOTORU (1 dk, %0,04×2 + 1 tick, sabit 500 $, basis = index fiyatı): net 8.740 $ (%1.748) · 2.557 işlem · PF 1,52
//   MaxDD 391 · DD P95/P99 220/314 (30 dk MTM) · Sharpe 2,42 · Calmar 3,79 · ilk/ikinci yarı 4.421/4.318 · monkey yön+zaman ✓
//   yıllar 2021 +2.197 · 2022 +2.258 · 2023 −67 · 2024 +1.015 · 2025 +2.532 · 2026 +804
//   TV penceresi (2023-02-06→): beklenen 4.207 $ / 1.682 işlem (long +3.853, short +354). TV'de DOĞRULANMADI.
//   Basis TV'de spot ile hesaplanır (motor index kullanır) → ilk TV export'unda X17 farkı kontrol edilecek.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
strategy("CYBORG | ZEC 1M ORKESTRA V2.1", shorttitle="ZEC1M-ORK", overlay=true, initial_capital=500,
     default_qty_type=strategy.cash, default_qty_value=500, commission_type=strategy.commission.percent, commission_value=0.04,
     slippage=1, process_orders_on_close=true, pyramiding=0, margin_long=0, margin_short=0, max_bars_back=2000)

// ── Sabitler ────────────────────────────────────────────────────────────────────────────────────
string BTC = "BINANCE:BTCUSDT.P"
string XMR = "BINANCE:XMRUSDT.P"
string BAT = "BINANCE:BATUSDT.P"
string PEP = "BINANCE:1000PEPEUSDT.P"
string ZOI = "BINANCE:ZECUSDT.P_OI"
string ZSP = "BINANCE:ZECUSDT"   // [REV-03] spot, basis için
float TS = 28.0              // [REV-03] bütün motorlar 28×ATR
float WF = 0.4
float R2 = math.sqrt(2.0)
// [REV-04] kayan örneklem std (O(1))
sdS(float x, int n) =>
    float m = ta.sma(x, n)
    float m2 = ta.sma(x * x, n)
    math.sqrt(math.max(m2 - m * m, 0) * n / (n - 1))

// ── 1 dk seriler ──────────────────────────────────────────────────────────────────────────────
float atr  = ta.rma(ta.tr(true), 60)
float btc1 = request.security(BTC, "1", close)
float xmr1 = request.security(XMR, "1", close)
float bat1 = request.security(BAT, "1", close)
float spot1 = request.security(ZSP, "1", close)   // [REV-03]

// ── Oylar ─────────────────────────────────────────────────────────────────────────────────────
float h4d = request.security(syminfo.tickerid, "240", (close - ta.ema(close, 50))[1], lookahead = barmerge.lookahead_on)
int vP04 = na(h4d) ? 0 : int(math.sign(h4d))
float zE = nz((close - ta.ema(close, 480)) / atr)
int vP08 = zE <= -8 * R2 ? 1 : zE >= 8 * R2 ? -1 : 0
float m20 = nz((close - close[40]) / atr)
float upF = nz(ta.highest(m20 >= 10 * R2 ? 1.0 : 0.0, 120))
float dnF = nz(ta.highest(m20 <= -10 * R2 ? 1.0 : 0.0, 120))
int vP09 = int(dnF - upF)
float mu = ta.sma(close, 240)
float sd = sdS(close, 240)   // [REV-04]
int vP10 = close < mu - 2.5 * sd ? 1 : close > mu + 2.5 * sd ? -1 : 0
float dz = nz(math.log(close / close[1]))
float db = nz(math.log(btc1 / btc1[1]))
float beta = nz(ta.sma(dz * db, 1440) / ta.sma(db * db, 1440))
float eR = dz - beta * db
float q = nz(math.sum(eR, 60) / (sdS(eR, 1440) * math.sqrt(60)))   // [REV-04]
int vP15 = q > 2 ? 1 : q < -2 ? -1 : 0
// [REV-02] OI oyları: 60 dk OI % değişimi ve fiyat yönü
float oi = request.security(ZOI, "5", close[1], lookahead = barmerge.lookahead_on)
float doi = nz((oi / oi[60] - 1) * 100)
float dp60 = nz((close / close[60] - 1) * 100)
int vP11 = doi > 1 and dp60 > 0 ? 1 : doi > 1 and dp60 < 0 ? -1 : 0
int vP12 = doi < -2 and dp60 < 0 ? 1 : doi < -2 and dp60 > 0 ? -1 : 0

// [REV-03] Yeni oylar
float e40 = ta.ema(close, 40)
float e120 = ta.ema(close, 120)
int vP01 = e40 > e120 ? 1 : e40 < e120 ? -1 : 0
var float fu = na
var float fd = na
var int vP02 = 1
float mST = 3 * R2
if not na(atr)
    float up = hl2 - mST * atr
    float dn = hl2 + mST * atr
    if na(fu)
        fu := up
        fd := dn
    else
        float fuP = fu
        float fdP = fd
        fu := close[1] > fuP ? math.max(up, fuP) : up
        fd := close[1] < fdP ? math.min(dn, fdP) : dn
        vP02 := close > fdP ? 1 : close < fuP ? -1 : vP02
float s30 = request.security(syminfo.tickerid, "30", (ta.ema(close, 20) - ta.ema(close, 20)[1])[1], lookahead = barmerge.lookahead_on)
int vP03 = na(s30) ? 0 : s30 > 0 ? 1 : s30 < 0 ? -1 : 0
float donM = (ta.highest(high, 240)[1] + ta.lowest(low, 240)[1]) / 2
int vP05 = na(donM) ? 0 : close > donM ? 1 : close < donM ? -1 : 0
float roc = nz((close - close[120]) / atr)
int vP06 = roc > R2 ? 1 : roc < -R2 ? -1 : 0
float bt60 = nz((btc1 / btc1[60] - 1) * 100)
int vP13 = bt60 > 0.1 * R2 ? 1 : bt60 < -0.1 * R2 ? -1 : 0
float xm60 = nz((xmr1 / xmr1[60] - 1) * 100)
int vP14 = xm60 > 0.2 * R2 ? 1 : xm60 < -0.2 * R2 ? -1 : 0
float flw = nz(math.sum(math.sign(close - open) * volume, 20) / math.sum(volume, 20))
int vX16 = flw > 0.15 ? 1 : flw < -0.15 ? -1 : 0
float bs = (close / spot1 - 1) * 1e4
float bz = nz((bs - ta.sma(bs, 1440)) / sdS(bs, 1440))   // [REV-04]
int vX17 = bz <= -2 ? 1 : bz >= 2 ? -1 : 0
int vP07 = 0   // RSI: hiçbir tabloda seçilmedi

// ── Rejim: 4s ADX ─────────────────────────────────────────────────────────────────────────────
dmi4() =>
    [p, m, a] = ta.dmi(14, 14)
    [a[1], p[1], m[1]]
[adx4, pdi4, mdi4] = request.security(syminfo.tickerid, "240", dmi4(), lookahead = barmerge.lookahead_on)
int RG = na(adx4) ? 9 : adx4 >= 20 ? int(math.sign(pdi4 - mdi4)) : 0
bool deB = request.security(syminfo.tickerid, "D", (close > ta.ema(close, 20))[1], lookahead = barmerge.lookahead_on)
int De = deB ? 1 : 0
int Xb = nz(xmr1[1] / xmr1[1441]) > 1 ? 1 : 0

// ── Rejim: saatlik akran özellikleri (kapanmış 1 s bar, saat başında güncellenir) ────────────────
atrp() => ta.rma(ta.tr(true), 14) / close * 100
lret() => math.log(close / close[1])
[zA, zR] = request.security(syminfo.tickerid, "60", [atrp()[1], lret()[1]], lookahead = barmerge.lookahead_on)
[bA, bR] = request.security(BTC, "60", [atrp()[1], lret()[1]], lookahead = barmerge.lookahead_on)
float xA = request.security(XMR, "60", atrp()[1], lookahead = barmerge.lookahead_on)
float tA = request.security(BAT, "60", atrp()[1], lookahead = barmerge.lookahead_on)
float pA = request.security(PEP, "60", atrp()[1], lookahead = barmerge.lookahead_on)

lastVals(array<float> a, int n) =>
    array<float> t = array.new_float(0)
    int sz = array.size(a)
    if sz > 0
        for i = math.max(0, sz - n) to sz - 1
            float v = array.get(a, i)
            if not na(v)
                array.push(t, v)
    t
medLast(array<float> a, int n, int minp) =>
    array<float> t = lastVals(a, n)
    array.size(t) >= minp ? array.median(t) : na
zLast(array<float> a, int n, int minp) =>
    array<float> t = lastVals(a, n)
    float x = array.size(a) > 0 ? array.get(a, array.size(a) - 1) : na
    array.size(t) >= minp and not na(x) ? (x - array.avg(t)) / array.stdev(t, false) : na
corrLast(array<float> a, array<float> b, int n, int minp) =>
    int sz = array.size(a)
    float sx = 0.0
    float sy = 0.0
    float sxx = 0.0
    float syy = 0.0
    float sxy = 0.0
    int k = 0
    if sz > 0
        for i = math.max(0, sz - n) to sz - 1
            float x = array.get(a, i)
            float y = array.get(b, i)
            if not na(x) and not na(y)
                sx += x
                sy += y
                sxx += x * x
                syy += y * y
                sxy += x * y
                k += 1
    float kf = k > 0 ? float(k) : 1.0
    float vx = sxx - sx * sx / kf
    float vy = syy - sy * sy / kf
    k >= minp and vx > 0 and vy > 0 ? (sxy - sx * sy / kf) / math.sqrt(vx * vy) : na
pushCap(array<float> a, float v) =>
    array.push(a, v)
    if array.size(a) > 2200
        array.shift(a)

var array<float> aZA = array.new_float(0)
var array<float> aPM = array.new_float(0)
var array<float> aZR = array.new_float(0)
var array<float> aBR = array.new_float(0)
var array<float> aREL = array.new_float(0)
var array<float> aBC = array.new_float(0)
var array<float> aAC = array.new_float(0)
var int K = 1
var int Vh = 1
var int A = 1
bool newH = nz(ta.change(time("60"))) != 0
if newH
    array<float> pk = array.new_float(0)
    if not na(bA)
        array.push(pk, bA)
    if not na(xA)
        array.push(pk, xA)
    if not na(tA)
        array.push(pk, tA)
    if not na(pA)
        array.push(pk, pA)
    float pm = array.size(pk) > 0 ? array.median(pk) : na
    pushCap(aZA, zA)
    pushCap(aPM, pm)
    pushCap(aZR, zR)
    pushCap(aBR, bR)
    pushCap(aREL, (not na(zA) and not na(pm) and pm > 0) ? math.log(zA / pm) : na)
    float relz = zLast(aREL, 720, 240)
    float atrC = corrLast(aZA, aPM, 168, 96)
    float btcC = corrLast(aZR, aBR, 72, 48)
    pushCap(aBC, btcC)
    pushCap(aAC, atrC)
    K  := nz(btcC - medLast(aBC, 2160, 500)) >= 0 ? 1 : 0
    Vh := nz(relz) >= 0 ? 1 : 0
    A  := nz(atrC - medLast(aAC, 2160, 500)) >= 0 ? 1 : 0

int g  = RG == 9 ? -1 : RG + 1
int rc = g < 0 ? -1 : ((g * 8 + K * 4 + Vh * 2 + A) * 2 + De) * 2 + Xb

// ── Kural tabloları (motor başına; karakter i = rejim hücresi i) ──────────────────────────────────
toArr(string m) =>
    array<bool> a = array.new_bool(96, false)
    for i = 0 to 95
        array.set(a, i, str.substring(m, i, i + 1) == "1")
    a
kural(array<bool> m, int v, int side) => rc >= 0 and rc < 96 ? (v == side and array.get(m, rc) ? 1 : 0) : 0
var array<bool> M_E0_P04_L = toArr("000111000000001111001001000001100000010000100010010000000011100001100001111001000001010001110011")
var array<bool> M_E0_P04_S = toArr("001000000000000101100100100000001110011110000101100000011001001011000000101100000000000010000000")
var array<bool> M_E0_P08_L = toArr("100010001010110000000000001010100100000000011010000010100000000000000000111100110100000000000000")
