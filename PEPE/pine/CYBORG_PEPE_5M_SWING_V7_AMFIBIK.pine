//@version=6
// ═══════════════════════════════════════════════════════════════════
// CYBORG | 1000PEPEUSDT.P 5M | SWING V7 AMFİBİK — TREND + YATAY + EKLEME
// LONG + SHORT | 500$ sabit birim, en fazla 3 birim (pyramiding 3)
// ───────────────────────────────────────────────────────────────────
// REV LOG
//  V4     : ÇARPIŞMA — sanal V2 (patlama) ve sanal V3 (V2 OR 4H swing) aynı yön → pozisyon
//  V6     : RSI14 UÇ motoru (<10 / >90, çıkış 50, kapanış stop %8, 144 bar) öncelikli
//           TV: 757 işlem | Net 6142$ | motor 753/757 eşleşti
//  V7     : [REV-11] YATAY MOTOR: 4H CHOP(14) > 61.8 iken RSI7 < 20 → LONG, > 80 → SHORT;
//                    çıkış RSI7 50 / kapanış stop %5 / 48 bar. V4 ve RSI-UÇ boşken devreye girer.
//           [REV-12] HTF TREND DOLGU: hepsi boşken 4H ADX > 30 ise 4H DI yönünde pozisyon.
//           [REV-13] EKLEME: pozisyon yönünde 48 bar kırılımı → +500$ birim;
//                    son giriş/eklemeden ≥ 48 bar; en fazla 3 birim. Tümü tek seferde kapanır.
//           Öncelik: RSI-UÇ > V4 ÇARPIŞMA > YATAY > HTF TREND > FLAT
// ───────────────────────────────────────────────────────────────────
// Araştırma motoru (1m OHLC 2023-05-05 → 2026-11-19, 500$ birim, %0.04, 1 tick, basit getiri):
//   V6 : Net 6172$  | PF 1.81 | Calmar 4.87 | MaxDD 358$ | net/MaxDD 17.3 | aylık medyan 122$
//   V7 : Net 13843$ | PF 1.78 | Calmar 4.56 | MaxDD 857$ | net/MaxDD 16.2 | aylık medyan 321$
//        Sharpe 2.39 | OOS(2025-05-20→) net 5483$ PF 2.16 | yıl medyanları 264/390/356/227$
// V7 TV Strategy Tester'da DOĞRULANMADI — doğrula.
//  V7.1   : [REV-14] initial_capital 10000 → 500, margin_long/short = 0 (şablon)
//           500$ sermayeye göre yıl %: 2023 517 | 2024 967 | 2025 688 | 2026 596 | medyan 642
// WunderTrading: bot max 3 giriş, her giriş 500$ sabit; ters ENTER = tümünü kapat + aç.
// ═══════════════════════════════════════════════════════════════════
strategy("CYBORG | PEPE 5M SWING V7 AMFIBIK",
     overlay = true,
     initial_capital = 500,                                                   // [REV-14] şablon: 500
     default_qty_type = strategy.cash,
     default_qty_value = 500,
     pyramiding = 3,
     margin_long = 0,                                                         // [REV-14] 3 birim / 500 sermaye reddedilmesin
     margin_short = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     max_bars_back = 2000)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. PARAMETRELER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp1 = "1. ADX"
diLen  = input.int(14, "DI Length", minval = 2, group = grp1)
adxLen = input.int(14, "ADX Smoothing", minval = 2, group = grp1)

grp2 = "2. MOTOR A — PATLAMA"
aAdx30Min = input.float(28.0, "A: 30M ADX Minimum", group = grp2)
aAdx5Min  = input.float(20.0, "A: 5M ADX Minimum", group = grp2)
aRiseLen  = input.int(12, "A: 5M ADX Yükselme Lookback", minval = 1, group = grp2)
aLookback = input.int(4, "A: Momentum Bar", minval = 1, group = grp2)
aMomLimit = input.float(3.0, "A: Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp2)

grp3 = "3. MOTOR B — 4H SWING"
bAdx30Min = input.float(25.0, "B: 30M ADX Minimum", group = grp3)
bRiseLen  = input.int(6, "B: 5M ADX Yükselme Lookback", minval = 1, group = grp3)
bLookback = input.int(48, "B: Momentum Bar", minval = 1, group = grp3)
bMomLimit = input.float(2.5, "B: Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp3)

grp4 = "4. SANAL MOTOR DÖNÜŞ"
minHold = input.int(24, "Min Sanal Pozisyon Süresi (bar)", minval = 0, group = grp4)

grp5 = "5. RSI UÇ MOTORU"
rsiLen     = input.int(14, "RSI Length", minval = 2, group = grp5)
rsiLo      = input.float(10.0, "RSI Uç Seviye", group = grp5)
rsiExit    = input.float(50.0, "RSI Çıkış Seviyesi", group = grp5)
rsiSL      = input.float(8.0, "RSI Kapanış Stopu %", minval = 0.1, group = grp5)
rsiMaxBars = input.int(144, "RSI Maks Bar", minval = 1, group = grp5)

grp6 = "6. YATAY MOTOR"                                                       // [REV-11]
chopLen   = input.int(14, "4H CHOP Length", minval = 2, group = grp6)
chopMin   = input.float(61.8, "4H CHOP Yatay Eşiği", group = grp6)
mrRsiLen  = input.int(7, "Yatay RSI Length", minval = 2, group = grp6)
mrLo      = input.float(20.0, "Yatay RSI Seviye", group = grp6)
mrExit    = input.float(50.0, "Yatay RSI Çıkış", group = grp6)
mrSL      = input.float(5.0, "Yatay Kapanış Stopu %", minval = 0.1, group = grp6)
mrMaxBars = input.int(48, "Yatay Maks Bar", minval = 1, group = grp6)

grp7 = "7. HTF TREND DOLGU"                                                   // [REV-12]
htfAdxMin = input.float(30.0, "4H ADX Trend Eşiği", group = grp7)

grp8 = "8. EKLEME"                                                            // [REV-13]
brkLen   = input.int(48, "Kırılım Bar Sayısı", minval = 2, group = grp8)
addGap   = input.int(48, "Eklemeler Arası Min Bar", minval = 1, group = grp8)
maxUnits = input.int(3, "Maks Birim", minval = 1, maxval = 3, group = grp8)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. TIMEFRAME GUARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Strateji yalnizca 5 dakikalik grafikte calisir.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. ADX / DI / CHOP — HTF son tamamlanmış mum, repaint yok
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_adx(int diLength, int smoothing) =>
    [plusDI, minusDI, adxValue] = ta.dmi(diLength, smoothing)
    adxValue

f_diDiff(int diLength, int smoothing) =>
    [plusDI, minusDI, adxValue] = ta.dmi(diLength, smoothing)
    plusDI - minusDI

f_chop(int n) =>
    rng = ta.highest(high, n) - ta.lowest(low, n)
    rng > 0 ? 100.0 * math.log10(math.sum(ta.tr(true), n) / rng) / math.log10(n) : na

adx5 = f_adx(diLen, adxLen)

adx30  = request.security(syminfo.tickerid, "30",  f_adx(diLen, adxLen)[1],    gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
adx240 = request.security(syminfo.tickerid, "240", f_adx(diLen, adxLen)[1],    gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)  // [REV-12]
di240  = request.security(syminfo.tickerid, "240", f_diDiff(diLen, adxLen)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)  // [REV-12]
chop240 = request.security(syminfo.tickerid, "240", f_chop(chopLen)[1],       gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)  // [REV-11]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. MOMENTUM / RSI / KIRILIM
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
momA = na(close[aLookback]) ? na : (close / close[aLookback] - 1.0) * 100.0
momB = na(close[bLookback]) ? na : (close / close[bLookback] - 1.0) * 100.0
rsiV  = ta.rsi(close, rsiLen)
rsiMR = ta.rsi(close, mrRsiLen)                                               // [REV-11]
hiBrk = ta.highest(high, brkLen)[1]                                           // [REV-13]
loBrk = ta.lowest(low, brkLen)[1]
brkLong  = not na(hiBrk) and close > hiBrk
brkShort = not na(loBrk) and close < loBrk

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. MOTOR SİNYALLERİ
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
aGate = not na(adx5) and not na(adx30) and not na(adx5[aRiseLen]) and
     adx30 > aAdx30Min and adx5 > aAdx5Min and adx5 > adx5[aRiseLen]
aLong  = aGate and not na(momA) and momA >= aMomLimit
aShort = aGate and not na(momA) and momA <= -aMomLimit

bGate = not na(adx5) and not na(adx30) and not na(adx5[bRiseLen]) and
     adx30 > bAdx30Min and adx5 > adx5[bRiseLen]
bLong  = bGate and not na(momB) and momB >= bMomLimit
bShort = bGate and not na(momB) and momB <= -bMomLimit

v3Long  = aLong or bLong
v3Short = aShort or bShort

rangeOn = not na(chop240) and chop240 > chopMin                               // [REV-11]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. SANAL MOTORLAR
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int   vV2    = 0
var int   vV2Bar = 0
var int   vV3    = 0
var int   vV3Bar = 0
var int   vR     = 0
var float vREp   = na
var int   vRBar  = 0
var int   vM     = 0                                                          // [REV-11]
var float vMEp   = na
var int   vMBar  = 0

if barstate.isconfirmed
    canV2 = vV2 == 0 or bar_index - vV2Bar >= minHold
    if aLong and vV2 <= 0 and canV2
        vV2    := 1
        vV2Bar := bar_index
    else if aShort and vV2 >= 0 and canV2
        vV2    := -1
        vV2Bar := bar_index

    canV3 = vV3 == 0 or bar_index - vV3Bar >= minHold
    if v3Long and vV3 <= 0 and canV3
        vV3    := 1
        vV3Bar := bar_index
    else if v3Short and vV3 >= 0 and canV3
        vV3    := -1
        vV3Bar := bar_index

    if not na(rsiV)
        if vR != 0
            rRet = (close / vREp - 1.0) * vR
            if rRet <= -rsiSL / 100.0 or bar_index - vRBar >= rsiMaxBars or (vR > 0 and rsiV > rsiExit) or (vR < 0 and rsiV < 100.0 - rsiExit)
                vR := 0
        else
            if rsiV < rsiLo
                vR    := 1
                vREp  := close
                vRBar := bar_index
            else if rsiV > 100.0 - rsiLo
                vR    := -1
                vREp  := close
                vRBar := bar_index

    if not na(rsiMR)                                                          // [REV-11]
        if vM != 0
            mRet = (close / vMEp - 1.0) * vM
            if mRet <= -mrSL / 100.0 or bar_index - vMBar >= mrMaxBars or (vM > 0 and rsiMR > mrExit) or (vM < 0 and rsiMR < 100.0 - mrExit)
                vM := 0
        else
            if rangeOn and rsiMR < mrLo
                vM    := 1
                vMEp  := close
                vMBar := bar_index
            else if rangeOn and rsiMR > 100.0 - mrLo
                vM    := -1
                vMEp  := close
                vMBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. HEDEF YÖN — RSI-UÇ > ÇARPIŞMA > YATAY > HTF TREND
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
collide = int(math.sign(vV2 + vV3))
tFill   = not na(adx240) and not na(di240) and adx240 > htfAdxMin ? (di240 > 0 ? 1 : di240 < 0 ? -1 : 0) : 0   // [REV-12]
target  = vR != 0 ? vR : collide != 0 ? collide : vM != 0 ? vM : tFill

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. EMİRLER — yön değişimi / ekleme
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int lastFillBar = 0
posDir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0

goLong  = barstate.isconfirmed and target != posDir and target == 1
goShort = barstate.isconfirmed and target != posDir and target == -1
goFlat  = barstate.isconfirmed and target != posDir and target == 0
canAdd  = barstate.isconfirmed and target == posDir and posDir != 0 and
     strategy.opentrades < maxUnits and bar_index - lastFillBar >= addGap      // [REV-13]
addLong  = canAdd and posDir == 1 and brkLong
addShort = canAdd and posDir == -1 and brkShort

if goLong
    strategy.entry("LONG", strategy.long, comment = "ENTER-LONG")
    lastFillBar := bar_index
else if goShort
    strategy.entry("SHORT", strategy.short, comment = "ENTER-SHORT")
    lastFillBar := bar_index
else if goFlat
    strategy.close_all(comment = "EXIT-ALL")
else if addLong
    strategy.entry("LONG", strategy.long, comment = "ENTER-LONG")
    lastFillBar := bar_index
else if addShort
    strategy.entry("SHORT", strategy.short, comment = "ENTER-SHORT")
    lastFillBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9. GÖRSEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(goLong, title = "LONG", style = shape.labelup, location = location.belowbar,
     color = color.lime, text = "LONG", textcolor = color.black, size = size.tiny)
plotshape(goShort, title = "SHORT", style = shape.labeldown, location = location.abovebar,
     color = color.red, text = "SHORT", textcolor = color.white, size = size.tiny)
plotshape(goFlat, title = "FLAT", style = shape.xcross, location = location.abovebar, color = color.gray, size = size.tiny)
plotshape(addLong, title = "ADD LONG", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)
plotshape(addShort, title = "ADD SHORT", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny)

bgcolor(rangeOn ? color.new(color.blue, 94) : na)

plot(adx30, "ADX 30M", display = display.data_window)
plot(adx240, "ADX 4H", display = display.data_window)
plot(chop240, "CHOP 4H", display = display.data_window)
plot(vR, "Sanal RSI-UÇ", display = display.data_window)
plot(collide, "Çarpışma", display = display.data_window)
plot(vM, "Sanal YATAY", display = display.data_window)
plot(tFill, "HTF Trend", display = display.data_window)
plot(target, "Hedef", display = display.data_window)
plot(strategy.opentrades, "Açık Birim", display = display.data_window)
