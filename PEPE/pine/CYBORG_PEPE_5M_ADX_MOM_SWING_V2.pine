//@version=6
// ═══════════════════════════════════════════════════════════════════
// CYBORG | 1000PEPEUSDT.P 5M | ADX-MOMENTUM SWING V2 | LONG + SHORT | FLAT YOK
// ───────────────────────────────────────────────────────────────────
// REV LOG
//  V1     : 30M ADX>20, 5M ADX>25, 4 bar momentum ±%1, ters sinyalde dönüş
//  V2     : [REV-01] 30M ADX eşiği 20 → 28
//           [REV-02] 5M ADX eşiği 25 → 20
//           [REV-03] 4 bar momentum eşiği %1 → %3   (sadece patlayıcı hareket)
//           [REV-04] 5M ADX yükseliyor: adx5 > adx5[12]   (trend güçleniyor)
//           [REV-05] Min pozisyon süresi 24 bar (2 saat) dolmadan ters dönüş yok
// SL / TP / TRAILING YOK — çıkış yalnızca ters sinyal (always-in swing)
// ───────────────────────────────────────────────────────────────────
// Araştırma motoru (1m OHLC 2023-05-05 → 2026-11-19, fixed 500$, %0.04, 1 tick):
//   V1 : Net −3015$ | PF 0.91 | 4815 işlem
//   V2 : Net +4881$ | PF 2.07 | 209 işlem | Calmar 2.46 | MaxDD 560$ | OOS PF 2.77
// Motor V1'de TV export ile eşleşti (son 1 yıl 788/791 işlem, PF 0.805/0.804).
// V2 TV Strategy Tester'da DOĞRULANMADI — doğrula.
// ═══════════════════════════════════════════════════════════════════
strategy("CYBORG | PEPE 5M ADX-MOM SWING V2",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.cash,
     default_qty_value = 500,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     max_bars_back = 2000)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. PARAMETRELER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp1 = "1. ADX"
diLen     = input.int(14, "DI Length", minval = 2, group = grp1)
adxLen    = input.int(14, "ADX Smoothing", minval = 2, group = grp1)
adx30Min  = input.float(28.0, "30M ADX Minimum", group = grp1)              // [REV-01]
adx5Min   = input.float(20.0, "5M ADX Minimum", group = grp1)               // [REV-02]
riseLen   = input.int(12, "5M ADX Yükselme Lookback (bar)", minval = 1, group = grp1)  // [REV-04]

grp2 = "2. MOMENTUM / DÖNÜŞ"
lookback      = input.int(4, "Momentum Bar Sayısı", minval = 1, group = grp2)
momentumLimit = input.float(3.0, "Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp2)  // [REV-03]
minHold       = input.int(24, "Min Pozisyon Süresi (bar)", minval = 0, group = grp2)           // [REV-05]

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. TIMEFRAME GUARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Strateji yalnizca 5 dakikalik grafikte calisir.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. ADX
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_adx(int diLength, int smoothing) =>
    [plusDI, minusDI, adxValue] = ta.dmi(diLength, smoothing)
    adxValue

adx5 = f_adx(diLen, adxLen)

// Son tamamlanmış 30M mumun ADX değeri — repaint yok
adx30 = request.security(
     syminfo.tickerid,
     "30",
     f_adx(diLen, adxLen)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

adxReady = not na(adx5) and not na(adx30) and not na(adx5[riseLen])
adxRise  = adxReady and adx5 > adx5[riseLen]                                // [REV-04]

trendAllowed = adxReady and
     adx30 > adx30Min and
     adx5 > adx5Min and
     adxRise

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. MOMENTUM
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
momentum = na(close[lookback]) ? na : (close / close[lookback] - 1.0) * 100.0

bullMomentum = not na(momentum) and momentum >= momentumLimit
bearMomentum = not na(momentum) and momentum <= -momentumLimit

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. SİNYAL + MIN HOLD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
longState  = trendAllowed and bullMomentum
shortState = trendAllowed and bearMomentum

barsInPos = strategy.position_size != 0 ? bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : 0
canFlip   = strategy.position_size == 0 or barsInPos >= minHold             // [REV-05]

longSignal  = barstate.isconfirmed and longState and strategy.position_size <= 0 and canFlip
shortSignal = barstate.isconfirmed and shortState and strategy.position_size >= 0 and canFlip

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. LONG / SHORT REVERSAL — SL/TP/TRAIL YOK
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if longSignal
    strategy.entry("LONG", strategy.long, comment = "ENTER-LONG")
else if shortSignal
    strategy.entry("SHORT", strategy.short, comment = "ENTER-SHORT")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. GÖRSEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(longSignal, title = "LONG", style = shape.labelup, location = location.belowbar,
     color = color.lime, text = "LONG", textcolor = color.black, size = size.tiny)
plotshape(shortSignal, title = "SHORT", style = shape.labeldown, location = location.abovebar,
     color = color.red, text = "SHORT", textcolor = color.white, size = size.tiny)

bgcolor(strategy.position_size > 0 ? color.new(color.lime, 93) : strategy.position_size < 0 ? color.new(color.red, 93) : na)

plot(adx5, "ADX 5M", display = display.data_window)
plot(adx30, "ADX 30M", display = display.data_window)
plot(momentum, "4-Bar Momentum %", display = display.data_window)
plot(barsInPos, "Bars In Position", display = display.data_window)
