//@version=6
// ═══════════════════════════════════════════════════════════════════
// CYBORG | 1000PEPEUSDT.P 5M | ADX-MOMENTUM SWING V6.2 — ÇARPIŞMA + RSI UÇ + ORTA REJİM
// ───────────────────────────────────────────────────────────────────
// REV LOG
//  V1     : 30M ADX>20, 5M ADX>25, 4 bar mom ±%1, ters sinyalde dönüş
//  V2     : 30M ADX>28, 5M ADX>20, mom %3, adx5>adx5[12], min hold 24  (TV: 209 işlem, net 4860$)
//  V3     : V2 (Motor A) OR Motor B [30M ADX>25, adx5>adx5[6], 48 bar mom ±%2.5]
//  V4     : [REV-07] ÇARPIŞMA — V2 ve V3 iki SANAL always-in motor olarak ayrı ayrı
//                    işletilir (her biri kendi min hold 24 sayacıyla).
//                    Gerçek pozisyon = sign(V2 + V3):
//                      ikisi LONG  → LONG 500$     (ENTER-LONG)
//                      ikisi SHORT → SHORT 500$    (ENTER-SHORT)
//                      ayrışma     → FLAT          (EXIT-ALL)
//           TV: 681 işlem | Net 4731$ | motor 677/681 eşleşti
//  V6     : [REV-10] RSI UÇ motoru (sanal): RSI14 < 10 → LONG, > 90 → SHORT;
//                    çıkış RSI 50'yi geçince / kapanışta −%8 / 144 bar.
//                    Sanal RSI pozisyonu varken gerçek pozisyonu O belirler (öncelik),
//                    yokken V4 çarpışma hedefi geçerli.
// Kalıcı stop / TP / trailing yok (RSI motorunun kendi %8 kapanış stopu hariç)
// ───────────────────────────────────────────────────────────────────
// Araştırma motoru (1m OHLC 2023-05-05 → 2026-11-19, 500$ sabit, %0.04, 1 tick, basit getiri):
//   V4 : Net 4751$ | PF 1.65 | 681 işlem | Calmar 3.75 | DD P98 273$ | MaxDD 358$ | net/MaxDD 13.3
//   V6 : Net 6172$ | PF 1.81 | 757 işlem | Calmar 4.87 | DD P98 273$ | MaxDD 358$ | net/MaxDD 17.3
//        OOS(2025-05-20→) net 2167$ PF 2.17 Calmar 6.72 | poz. ay %84
//           TV: 757 işlem | Net 6142$ (%1228)
//  V6.2   : [REV-15] ORTA REJİM MOTORU (sanal, always-in): 30M ADX > 18 ve adx5 > adx5[3] iken
//                    24 bar (2 saat) momentum ±%3 → LONG/SHORT; kendi min hold 12 bar.
//                    RSI-UÇ ve ÇARPIŞMA boşken pozisyonu taşır (V6'nın %42 FLAT süresini doldurur).
//           [REV-14] initial_capital 500, margin 0 (şablon)
//   V6.2 (sabit 500$, motor): Net 6748$ (%1350) | 1180 işlem | PF 1.52 | DD P98 257$ | OOS Calmar 7.23
//        V6'ya göre: son 30g +10→+57$ | 2024-08 penceresi −209→−10$ | en kötü ay −227→−157$
// V6.2 TV Strategy Tester'da DOĞRULANMADI — doğrula.
// ═══════════════════════════════════════════════════════════════════
strategy("CYBORG | PEPE 5M ADX-MOM SWING V6.2",
     overlay = true,
     initial_capital = 500,
     default_qty_type = strategy.cash,
     default_qty_value = 500,
     pyramiding = 0,
     margin_long = 0,
     margin_short = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     max_bars_back = 2000)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. PARAMETRELER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp1 = "1. ADX"
diLen  = input.int(14, "DI Length", minval = 2, group = grp1)
adxLen = input.int(14, "ADX Smoothing", minval = 2, group = grp1)

grp2 = "2. MOTOR A — PATLAMA (V2)"
aAdx30Min = input.float(28.0, "A: 30M ADX Minimum", group = grp2)
aAdx5Min  = input.float(20.0, "A: 5M ADX Minimum", group = grp2)
aRiseLen  = input.int(12, "A: 5M ADX Yükselme Lookback", minval = 1, group = grp2)
aLookback = input.int(4, "A: Momentum Bar", minval = 1, group = grp2)
aMomLimit = input.float(3.0, "A: Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp2)

grp3 = "3. MOTOR B — 4H SWING (V3 eki)"
bAdx30Min = input.float(25.0, "B: 30M ADX Minimum", group = grp3)
bRiseLen  = input.int(6, "B: 5M ADX Yükselme Lookback", minval = 1, group = grp3)
bLookback = input.int(48, "B: Momentum Bar", minval = 1, group = grp3)
bMomLimit = input.float(2.5, "B: Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp3)

grp5 = "5. RSI UÇ MOTORU"                                                     // [REV-10]
rsiLen     = input.int(14, "RSI Length", minval = 2, group = grp5)
rsiLo      = input.float(10.0, "RSI Uç Seviye (long <, short > 100-x)", group = grp5)
rsiExit    = input.float(50.0, "RSI Çıkış Seviyesi", group = grp5)
rsiSL      = input.float(8.0, "RSI Kapanış Stopu %", minval = 0.1, group = grp5)
rsiMaxBars = input.int(144, "RSI Maks Bar", minval = 1, group = grp5)

grp6 = "6. ORTA REJİM MOTORU"                                                 // [REV-15]
mLookback = input.int(24, "M: Momentum Bar", minval = 1, group = grp6)
mMomLimit = input.float(3.0, "M: Momentum Eşiği %", minval = 0.1, step = 0.25, group = grp6)
mAdx30Min = input.float(18.0, "M: 30M ADX Minimum", group = grp6)
mRiseLen  = input.int(3, "M: 5M ADX Yükselme Lookback", minval = 1, group = grp6)
mHold     = input.int(12, "M: Min Sanal Pozisyon Süresi (bar)", minval = 0, group = grp6)

grp4 = "4. SANAL MOTOR DÖNÜŞ"
minHold = input.int(24, "Min Sanal Pozisyon Süresi (bar)", minval = 0, group = grp4)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. TIMEFRAME GUARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Strateji yalnizca 5 dakikalik grafikte calisir.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. ADX
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
f_adx(int diLength, int smoothing) =>
    [plusDI, minusDI, adxValue] = ta.dmi(diLength, smoothing)
    adxValue

adx5 = f_adx(diLen, adxLen)

// Son tamamlanmış 30M mumun ADX değeri — repaint yok
adx30 = request.security(
     syminfo.tickerid,
     "30",
     f_adx(diLen, adxLen)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. MOMENTUM
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
momA = na(close[aLookback]) ? na : (close / close[aLookback] - 1.0) * 100.0
momB = na(close[bLookback]) ? na : (close / close[bLookback] - 1.0) * 100.0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. MOTOR A — PATLAMA
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
aGate = not na(adx5) and not na(adx30) and not na(adx5[aRiseLen]) and
     adx30 > aAdx30Min and adx5 > aAdx5Min and adx5 > adx5[aRiseLen]
aLong  = aGate and not na(momA) and momA >= aMomLimit
aShort = aGate and not na(momA) and momA <= -aMomLimit

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. MOTOR B — 4H SWING
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
bGate = not na(adx5) and not na(adx30) and not na(adx5[bRiseLen]) and
     adx30 > bAdx30Min and adx5 > adx5[bRiseLen]
bLong  = bGate and not na(momB) and momB >= bMomLimit
bShort = bGate and not na(momB) and momB <= -bMomLimit

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. SANAL MOTORLAR (always-in, ayrı hold sayacı)                   [REV-07]
//    vV2 = V2 sistemi (Motor A)      vV3 = V3 sistemi (A OR B)
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var int vV2    = 0
var int vV2Bar = 0
var int vV3    = 0
var int vV3Bar = 0

v3Long  = aLong or bLong
v3Short = aShort or bShort

if barstate.isconfirmed
    canV2 = vV2 == 0 or bar_index - vV2Bar >= minHold
    if aLong and vV2 <= 0 and canV2
        vV2    := 1
        vV2Bar := bar_index
    else if aShort and vV2 >= 0 and canV2
        vV2    := -1
        vV2Bar := bar_index

    canV3 = vV3 == 0 or bar_index - vV3Bar >= minHold
    if v3Long and vV3 <= 0 and canV3
        vV3    := 1
        vV3Bar := bar_index
    else if v3Short and vV3 >= 0 and canV3
        vV3    := -1
        vV3Bar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7b. SANAL RSI UÇ MOTORU                                           [REV-10]
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
rsiV = ta.rsi(close, rsiLen)

var int   vR    = 0
var float vREp  = na
var int   vRBar = 0

if barstate.isconfirmed and not na(rsiV)
    if vR != 0
        rRet = (close / vREp - 1.0) * vR
        if rRet <= -rsiSL / 100.0 or bar_index - vRBar >= rsiMaxBars or (vR > 0 and rsiV > rsiExit) or (vR < 0 and rsiV < 100.0 - rsiExit)
            vR := 0
    else
        if rsiV < rsiLo
            vR    := 1
            vREp  := close
            vRBar := bar_index
        else if rsiV > 100.0 - rsiLo
            vR    := -1
            vREp  := close
            vRBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7c. SANAL ORTA REJİM MOTORU                                       [REV-15]
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
momM  = na(close[mLookback]) ? na : (close / close[mLookback] - 1.0) * 100.0
mGate = not na(adx5) and not na(adx30) and not na(adx5[mRiseLen]) and
     adx30 > mAdx30Min and adx5 > adx5[mRiseLen]
mLong  = mGate and not na(momM) and momM >= mMomLimit
mShort = mGate and not na(momM) and momM <= -mMomLimit

var int vMid    = 0
var int vMidBar = 0

if barstate.isconfirmed
    canMid = vMid == 0 or bar_index - vMidBar >= mHold
    if mLong and vMid <= 0 and canMid
        vMid    := 1
        vMidBar := bar_index
    else if mShort and vMid >= 0 and canMid
        vMid    := -1
        vMidBar := bar_index

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. HEDEF: RSI UÇ > ÇARPIŞMA > ORTA REJİM                        [REV-07/10]
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
collide = int(math.sign(vV2 + vV3))
target  = vR != 0 ? vR : collide != 0 ? collide : vMid                       // [REV-10/15]

goLong  = barstate.isconfirmed and target == 1 and strategy.position_size <= 0
goShort = barstate.isconfirmed and target == -1 and strategy.position_size >= 0
goFlat  = barstate.isconfirmed and target == 0 and strategy.position_size != 0

if goLong
    strategy.entry("LONG", strategy.long, comment = "ENTER-LONG")
else if goShort
    strategy.entry("SHORT", strategy.short, comment = "ENTER-SHORT")
else if goFlat
    strategy.close_all(comment = "EXIT-ALL")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9. GÖRSEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(goLong, title = "LONG", style = shape.labelup, location = location.belowbar,
     color = color.lime, text = "LONG", textcolor = color.black, size = size.tiny)
plotshape(goShort, title = "SHORT", style = shape.labeldown, location = location.abovebar,
     color = color.red, text = "SHORT", textcolor = color.white, size = size.tiny)
plotshape(goFlat, title = "FLAT", style = shape.xcross, location = location.abovebar,
     color = color.gray, size = size.tiny)

bgcolor(strategy.position_size > 0 ? color.new(color.lime, 92) : strategy.position_size < 0 ? color.new(color.red, 92) : color.new(color.gray, 95))

plot(adx5, "ADX 5M", display = display.data_window)
plot(adx30, "ADX 30M", display = display.data_window)
plot(momA, "Mom A (4 bar) %", display = display.data_window)
plot(momB, "Mom B (48 bar) %", display = display.data_window)
plot(vV2, "Sanal V2", display = display.data_window)
plot(vV3, "Sanal V3", display = display.data_window)
plot(vR, "Sanal RSI", display = display.data_window)
plot(rsiV, "RSI", display = display.data_window)
plot(vMid, "Sanal ORTA", display = display.data_window)
plot(momM, "Mom M (24 bar) %", display = display.data_window)
plot(target, "Hedef", display = display.data_window)
