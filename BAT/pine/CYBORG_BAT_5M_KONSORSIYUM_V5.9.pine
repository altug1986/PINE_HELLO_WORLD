//     son 200 gün −43$ (V5.6B −100$) | komşu 10 ayar: net 7926–8367$, 30 dk MaxDD 328–362$, ikinci dönem 2103–2165$
//  V5.8   : [REV-16] BALİNA KAPISI: Binance top trader POZİSYON oranı ÷ HESAP oranı (log fark), son 720 saatlik (30 gün) z-skoru.
//           z ≥ +1 → yeni LONG yok | z ≤ −1 → yeni SHORT yok (büyük para sayılarına göre alışılmadık ölçüde bizim yönde yığılmış)
//           veri: önceki tamamlanmış 1S mum | veri yoksa kapı devre dışı → V5.7 ile aynı çalışır (sağ üst tablo durumu gösterir)
//   V5.8 motor (Binance metrics 2021-12 → 2026-11; top trader verisi 2023'ten itibaren dolu): Net 8426$ | ilk dönem 5999$ / ikinci dönem 2419$
//     son 12 ay +919$ (V5.7 +647$) | son 200 gün +220$ (V5.7 −43$) | 30 dk açık poz: MaxDD 308$ | Calmar 4.11 | DD P95/P98/P99 169/203/220$
//     komşular: pencere 960 saat 8435$ / 504 saat 8228$ | eşik 0.75: 8116$ | 5 dk örneklemli eşdeğeri 8406$, 0–3 bar gecikmede 8380–8443$
//   UYARI: 2023 – Ekim 2024 arasında kapı −167$ (ilk dönem doğrulamıyor); kazanç ikinci dönem ve son 200 günde.
//   UYARI: TradingView top trader ticker adları DOĞRULANMADI → "8. BALİNA KAPISI" girişlerine doğru ticker'ı yaz; tablo VAR göstermeli.
//  V5.9   : [REV-17] 2. BALİNA KAPISI (24 SAAT): aynı oranın son 24 saatlik z-skoru ≥ +1.5 → yeni LONG yok | ≤ −1.5 → yeni SHORT yok
//           (30 günlük kapı ile VEYA bağlı; ikisinden biri kapalıysa giriş yok)
//   V5.9 motor: Net 8522$ | 2714 işlem | ilk dönem 6035$ / ikinci dönem 2480$ | son 12 ay +1035$ | son 200 gün +348$
//     30 dk açık poz: MaxDD 305$ | Calmar 4.20 | DD P95/P98/P99 166/199/215$
//     komşular: 24s eşik 1.0 / 2.0 → 8321 / 8505$ | 72 saat pencere eşik 1.5 / 2.0 → 8419 / 8479$
//   Pine algoritması Python'da birebir taklit edildi: Net 8522$, kapı durumu motorla %100 aynı (TV farkı yalnız veri/ticker kaynaklı olabilir)
//   UYARI: 24 saatlik kapı zamanlamaya hassas: veri 1 saat geç → 8356$ (V5.8'in altı), 2 saat geç → 8435$. 30 günlük kapı 1–2 saat gecikmede tutuyor.
// OI ve BTC sembolleri yüklenmezse bileşen 7, 8, 10, 11 sıfır kalır.
// WunderTrading soketleri YER TUTUCU: BOTADI / BOTKODU kısmını BAT botunun kendi soket metniyle değiştir.
// ═══════════════════════════════════════════════════════════════════
strategy("CYBORG | BAT 5M KONSORSİYUM V5.9",
     overlay = true,
     initial_capital = 500,
     default_qty_type = strategy.cash,
     default_qty_value = 500,
     pyramiding = 0,
     margin_long = 0,
     margin_short = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.04,
     slippage = 1,
     process_orders_on_close = true,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     max_bars_back = 2000)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. PARAMETRELER                                                    [REV-08]
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
grp1 = "1. BİLEŞEN AĞIRLIKLARI"
w1  = input.float(3.0, "1 DÖNÜŞ 24s (V1.0)", step = 0.05, group = grp1)
w2  = input.float(3.0, "2 DÖNÜŞ z 4s", step = 0.05, group = grp1)
w3  = input.float(4.0, "3 DÖNÜŞ z 8s", step = 0.05, group = grp1)
w4  = input.float(0.0, "4 DÖNÜŞ 4s uzama", step = 0.05, group = grp1)
w5  = input.float(0.0, "5 DÖNÜŞ 3g uzama", step = 0.05, group = grp1)
w6  = input.float(1.0, "6 DÖNÜŞ RSI14", step = 0.05, group = grp1)
w7  = input.float(1.0, "7 DÖNÜŞ likidasyon (OI)", step = 0.05, group = grp1)
w8  = input.float(3.0, "8 DÖNÜŞ OI kurulum", step = 0.05, group = grp1)
w9  = input.float(0.5, "9 DÖNÜŞ hacim klimaks", step = 0.05, group = grp1)
w10 = input.float(1.0, "10 DÖNÜŞ BTC göreli", step = 0.05, group = grp1)
w11 = input.float(4.0, "11 TAKİP BTC lider", step = 0.05, group = grp1)
w12 = input.float(0.5, "12 TAKİP %3", step = 0.05, group = grp1)
w13 = input.float(2.0, "13 TAKİP %8", step = 0.05, group = grp1)
w14 = input.float(0.5, "14 TAKİP günlük momentum", step = 0.05, group = grp1)

grp2 = "2. OY"
onThr  = input.float(0.04, "Giriş Eşiği (skor)", step = 0.01, group = grp2)              // [REV-15] 0.08→0.04
offThr = input.float(0.0, "Çıkış Eşiği (skor yön × pozisyon <)", step = 0.01, group = grp2)

grp4 = "4. POZ İÇİ ZARAR SINIRI"                                    // [REV-10]
stopPct = input.float(7.0, "Poz İçi Zarar Sınırı % (kapanış)", minval = 0.5, step = 0.5, group = grp4)
reArm   = input.float(4.0, "Stop Sonrası Geri Giriş: Uçtan Tepki %", minval = 0.1, step = 0.5, group = grp4)

grp5 = "5. HACİM ORANI"                                              // [REV-12]
w15         = input.float(1.0, "15 DÖNÜŞ BAT/BTC hacim oranı (ağırlık)", step = 0.05, group = grp5)
k15         = input.float(1.5, "15: Hacim Oranı ≥ x", step = 0.1, group = grp5)
a15         = input.float(4.0, "15: 24s Hareket ≥ %", step = 0.5, group = grp5)

grp6 = "6. POZDA KALIŞ + GİRİŞ KAPISI"                               // [REV-13]
tsBars  = input.int(648, "Pozda Kalış: En Az Bar", minval = 1, group = grp6)                   // [REV-15] 576→648
tsLoss  = input.float(1.0, "Pozda Kalış: Zarar ≥ %", step = 0.5, group = grp6)                 // [REV-15] 2→1
tsAdx   = input.float(20.0, "Pozda Kalış: 15 dk ADX <", step = 1.0, group = grp6)
nrMin   = input.float(0.1, "Giriş Yok: Hacim Oranı <", step = 0.05, group = grp6)

grp7 = "7. 1 SAATLİK TREND EŞİĞİ"                                    // [REV-14]
trBatF  = input.int(5, "BAT 1S EMA Hızlı", minval = 1, group = grp7)
trBatS  = input.int(17, "BAT 1S EMA Yavaş", minval = 1, group = grp7)
trBtcF  = input.int(5, "BTC 1S EMA Hızlı", minval = 1, group = grp7)
trBtcS  = input.int(20, "BTC 1S EMA Yavaş", minval = 1, group = grp7)
trAdx   = input.float(20.0, "BAT 1S ADX ≥", step = 1.0, group = grp7)                        // [REV-15] 25→20
onTrend = input.float(0.15, "Trende Ters Giriş Eşiği (skor)", step = 0.01, group = grp7)       // [REV-15] 0.12→0.15
blPct   = input.float(2.5, "11 BTC lider: BTC 3 bar hareket %", step = 0.25, group = grp7)

grp8 = "8. BALİNA KAPISI"                                             // [REV-16]
whPosSym = input.string("BINANCE:BATUSDT.P_TOP_TRADER_POSITIONS_LSR", "Top Trader POZİSYON oranı ticker (doğrula)", group = grp8)
whAccSym = input.string("BINANCE:BATUSDT.P_TOP_TRADER_ACCOUNTS_LSR", "Top Trader HESAP oranı ticker (doğrula)", group = grp8)
whN      = input.int(720, "z penceresi (1S mum)", minval = 24, group = grp8)
whK      = input.float(1.0, "Kapı eşiği (z)", step = 0.05, group = grp8)
wh24N    = input.int(24, "2. kapı z penceresi (1S mum)", minval = 4, group = grp8)          // [REV-17]
wh24K    = input.float(1.5, "2. kapı eşiği (z)", step = 0.05, group = grp8)                // [REV-17]

grp3 = "3. DIŞ VERİ"
oiSym  = input.symbol("BINANCE:BATUSDT.P_OI", "BAT OI Sembol", group = grp3)
btcSym = input.symbol("BINANCE:BTCUSDT.P", "BTC Sembol", group = grp3)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. TIMEFRAME GUARD
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
if barstate.isfirst and timeframe.in_seconds() != 300
    runtime.error("Strateji yalnizca 5 dakikalik grafikte calisir.")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. TİPLER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// sinyal + süre + kapanış stopu
type Ent
    int   v  = 0
    float e  = na
    int   vb = 0

method step(Ent this, int s, float c, int bi, int hold, float sl) =>
    if this.v != 0
        if (c / this.e - 1.0) * this.v <= -sl / 100.0 or bi - this.vb >= hold
            this.v := 0
    if s != 0
        if this.v != s
            this.v  := s
            this.e  := c
            this.vb := bi
        else
            this.vb := bi
    this.v

// osilatör dönüşü (çıkış barında yeni giriş yok)
type Osc
    int   v  = 0
    float e  = na
    int   vb = 0

method step(Osc this, float x, float c, int bi, float lo, float hi, float exL, float exS, float sl, int mb) =>
    if not na(x)
        if this.v != 0
            if (c / this.e - 1.0) * this.v <= -sl / 100.0 or bi - this.vb >= mb or (this.v > 0 and x > exL) or (this.v < 0 and x < exS)
                this.v := 0
        else
            if x < lo
                this.v  := 1
                this.e  := c
                this.vb := bi
            else if x > hi
                this.v  := -1
                this.e  := c
                this.vb := bi
    this.v

// % dönüş takipçisi
type Rev
    int   v  = 0
    float hi = na
    float lo = na

method step(Rev this, float c, float pct) =>
    if na(this.hi)
        this.hi := c
        this.lo := c
    if this.v >= 0
        this.hi := math.max(this.hi, c)
        if c <= this.hi * (1.0 - pct / 100.0)
            this.v  := -1
            this.lo := c
    if this.v <= 0
        this.lo := math.min(this.lo, c)
        if c >= this.lo * (1.0 + pct / 100.0)
            this.v  := 1
            this.hi := c
    this.v

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. VERİ VE SİNYALLER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
oiRaw = request.security(oiSym, timeframe.period, close, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
oiP   = oiRaw[1]
btc   = request.security(btcSym, timeframe.period, close, gaps = barmerge.gaps_off)
f_dm() =>
    m = (close / close[30] - 1.0) * 100.0
    na(m) ? 0 : m >= 5.0 ? 1 : m <= -5.0 ? -1 : 0
dmSig = request.security(syminfo.tickerid, "D", f_dm()[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

d288 = na(close[288]) ? na : (close / close[288] - 1.0) * 100.0
// [REV-12] BAT/BTC 30 dk hacim oranı | [REV-13] 15 dk ADX (önceki tamamlanmış 15 dk mum)
btcV  = request.security(btcSym, timeframe.period, volume, gaps = barmerge.gaps_off)
batQ6 = math.sum(volume * close, 6)
btcQ6 = math.sum(btcV * btc, 6)
r30   = not na(btcQ6) and btcQ6 > 0 ? batQ6 / btcQ6 : na
r30m  = ta.sma(r30, 1728)
nrv   = not na(r30) and not na(r30m) and r30m > 0 ? r30 / r30m : 1.0
f_adx15() =>
    [p15, m15, x15] = ta.dmi(14, 14)
    x15
adx15 = nz(request.security(syminfo.tickerid, "15", f_adx15()[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on), 0.0)
gate  = nrv < nrMin                                                      // [REV-13] yeni giriş kapısı | [REV-15] saat yasağı kaldırıldı
// [REV-14] 1 saatlik trend: önceki tamamlanmış 1S mum
f_adx60() =>
    [p60, m60, x60] = ta.dmi(14, 14)
    x60
bEf   = request.security(syminfo.tickerid, "60", ta.ema(close, trBatF)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
bEs   = request.security(syminfo.tickerid, "60", ta.ema(close, trBatS)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
xEf   = request.security(btcSym, "60", ta.ema(close, trBtcF)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
xEs   = request.security(btcSym, "60", ta.ema(close, trBtcS)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
adx1h = nz(request.security(syminfo.tickerid, "60", f_adx60()[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on), 0.0)
bTr   = na(bEf) or na(bEs) ? 0 : math.sign(bEf - bEs)
xTr   = na(xEf) or na(xEs) ? 0 : math.sign(xEf - xEs)
trDir = bTr == xTr ? bTr : 0
onL   = trDir == -1 and adx1h >= trAdx ? onTrend : onThr                    // düşüşte long için daha güçlü oy
// [REV-16] balina kapısı: önceki tamamlanmış 1S mum, log(pozisyon oranı) − log(hesap oranı), son whN saatin z-skoru
whPos = request.security(whPosSym, "60", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
whAcc = request.security(whAccSym, "60", close[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
// [REV-17] motorla birebir: tekrar eden (boş saat) değer atlanır, pencereler TAKVİM saatiyle kırpılır (son whN / wh24N saat)
var array<float> whV = array.new_float()
var array<int>   whT = array.new_int()
var float whLast = na
var float whZ    = na
var float whZ24  = na
if ta.change(time("60")) != 0
    whZ   := na
    whZ24 := na
    if not na(whPos) and not na(whAcc) and whPos > 0 and whAcc > 0
        dv = math.log(whPos) - math.log(whAcc)
        if na(whLast) or dv != whLast
            whV.push(dv)
            whT.push(time)
            while whT.size() > 0 and whT.first() <= time - whN * 3600000
                whT.shift()
                whV.shift()
            if whV.size() >= whN / 2
                sd30 = whV.stdev(false)
                whZ := sd30 > 0 ? (dv - whV.avg()) / sd30 : na
            c24 = 0
            for k = whT.size() - 1 to 0
                if whT.get(k) <= time - wh24N * 3600000
                    break
                c24 += 1
            if c24 >= wh24N / 2
                sub24 = whV.slice(whV.size() - c24, whV.size())
                sd24  = sub24.stdev(false)
                whZ24 := sd24 > 0 ? (dv - sub24.avg()) / sd24 : na
        whLast := dv
whOk  = not na(whPos) and not na(whAcc)
gateL = whOk and ((not na(whZ) and whZ >= whK) or (not na(whZ24) and whZ24 >= wh24K))     // balinalar long tarafta yığılı → yeni long yok
gateS = whOk and ((not na(whZ) and whZ <= -whK) or (not na(whZ24) and whZ24 <= -wh24K))   // balinalar short tarafta yığılı → yeni short yok
onS   = trDir == 1 and adx1h >= trAdx ? onTrend : onThr                     // yükselişte short için daha güçlü oy
s15   = na(d288) ? 0 : nrv >= k15 and math.abs(d288) >= a15 ? (d288 > 0 ? -1 : d288 < 0 ? 1 : 0) : 0
d48  = na(close[48])  ? na : (close / close[48]  - 1.0) * 100.0
d864 = na(close[864]) ? na : (close / close[864] - 1.0) * 100.0
sV1  = na(d288) ? 0 : d288 <= -3.5 ? 1 : d288 >= 6.0 ? -1 : 0                          // [REV-09] 5.5→6
s4s  = na(d48)  ? 0 : d48 <= -8.0 ? 1 : d48 >= 8.0 ? -1 : 0                            // [REV-09] 6→8
s3g  = na(d864) ? 0 : d864 <= -12.0 ? 1 : d864 >= 12.0 ? -1 : 0

zB48 = ta.sma(close, 48)
zD48 = ta.stdev(close, 48)
z48  = not na(zD48) and zD48 > 0 ? (close - zB48) / zD48 : na
zB96 = ta.sma(close, 96)
zD96 = ta.stdev(close, 96)
z96  = not na(zD96) and zD96 > 0 ? (close - zB96) / zD96 : na
r14  = ta.rsi(close, 14)
r7   = ta.rsi(close, 7)

dO288 = not na(oiP) and not na(oiP[288]) and oiP[288] > 0 ? (oiP / oiP[288] - 1.0) * 100.0 : na
sOIK  = na(d288) or na(dO288) ? 0 : math.abs(d288) >= 4.0 and dO288 >= 6.0 ? (d288 > 0 ? -1 : d288 < 0 ? 1 : 0) : 0   // [REV-09] 5/5→4/6
vr    = math.sum(volume, 288) / (math.sum(volume, 1728) / 1728.0 * 288.0)
sHVX  = na(d288) or na(vr) ? 0 : math.abs(d288) >= 5.0 and vr >= 1.5 ? (d288 > 0 ? -1 : d288 < 0 ? 1 : 0) : 0   // [REV-09] 1.3→1.5
dB288 = na(btc[288]) ? na : (btc / btc[288] - 1.0) * 100.0
rr    = na(d288) or na(dB288) ? na : d288 - dB288
sREL  = na(rr) ? 0 : math.abs(rr) >= 6.0 ? (rr > 0 ? -1 : rr < 0 ? 1 : 0) : 0

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. BİLEŞENLER + OY
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
var Ent cV1  = Ent.new()
var Osc cZ4  = Osc.new()
var Osc cZ8  = Osc.new()
var Ent c4s  = Ent.new()
var Ent c3g  = Ent.new()
var Osc cRSI = Osc.new()
var Ent cOIK = Ent.new()
var Ent cHVX = Ent.new()
var Ent cREL = Ent.new()
var Rev cT3  = Rev.new()
var Rev cT8  = Rev.new()
var Ent c15  = Ent.new()                                                  // [REV-12]
var int   vLiq = 0
var float vLiqEp = na
var int   vLiqB = 0
var int   vBL  = 0
var int   vBLb = 0
var int   vDM  = 0
var int   pos  = 0
var int   realDir = 0                                                     // [REV-10] gerçek yön
var float rEp     = na
var int   lockDir = 0
var float lockExt = na
var int   prevT   = 0
var int   rEb     = 0                                                     // [REV-13] gerçek poz giriş barı
var float score = 0.0
var array<int> P = array.new_int(15, 0)

if barstate.isconfirmed
    // 7 LİKİDASYON (OI)
    okO  = not na(oiP) and not na(oiP[6]) and oiP > 0 and oiP[6] > 0
    dOi6 = okO ? (oiP / oiP[6] - 1.0) * 100.0 : 0.0
    dPx6 = (close / close[6] - 1.0) * 100.0
    liqL = okO and dPx6 <= -1.5 and dOi6 <= -2.0                               // [REV-09] OI −1.5→−2
    liqS = okO and dPx6 >= 1.5 and dOi6 <= -2.0
    if vLiq != 0
        lRet = (close / vLiqEp - 1.0) * vLiq
        if lRet <= -5.0 / 100.0 or bar_index - vLiqB >= 144 or (vLiq > 0 and r7 > 65.0) or (vLiq < 0 and r7 < 35.0)
            vLiq := 0
        else if vLiq > 0 and liqS
            vLiq   := -1
            vLiqEp := close
            vLiqB  := bar_index
        else if vLiq < 0 and liqL
            vLiq   := 1
            vLiqEp := close
            vLiqB  := bar_index
    else
        if liqL
            vLiq   := 1
            vLiqEp := close
            vLiqB  := bar_index
        else if liqS
            vLiq   := -1
            vLiqEp := close
            vLiqB  := bar_index
    // 11 BTC LİDER
    if vBL != 0 and bar_index - vBLb >= 24
        vBL := 0
    if not na(btc) and not na(btc[3]) and not na(close[3])
        br = (btc / btc[3] - 1.0) * 100.0
        ar = (close / close[3] - 1.0) * 100.0
        if br >= blPct and ar < br                                         // [REV-14] 2.0→2.5
            vBL  := 1
            vBLb := bar_index
        else if br <= -blPct and ar > br
            vBL  := -1
            vBLb := bar_index
    // 14 GÜNLÜK MOMENTUM (önceki tamamlanmış gün, sıfırda önceki yön korunur)
    if dmSig != 0
        vDM := dmSig
    P.set(0,  cV1.step(sV1, close, bar_index, 648, 3.0))
    P.set(1,  cZ4.step(z48, close, bar_index, -4.0, 4.0, 0.5, -0.5, 8.0, 288))      // [REV-11] ±3.5→±4
    P.set(2,  cZ8.step(z96, close, bar_index, -3.5, 3.5, 0.0, 0.0, 8.0, 288))     // [REV-09] çıkış 0.5→0
    P.set(3,  c4s.step(s4s, close, bar_index, 48, 10.0))
    P.set(4,  c3g.step(s3g, close, bar_index, 1728, 10.0))
    P.set(5,  cRSI.step(r14, close, bar_index, 20.0, 80.0, 45.0, 55.0, 3.0, 144))   // [REV-11] çıkış 50→45/55
    P.set(6,  vLiq)
    P.set(7,  cOIK.step(sOIK, close, bar_index, 144, 10.0))                          // [REV-09] 288→144
    P.set(8,  cHVX.step(sHVX, close, bar_index, 288, 10.0))
    P.set(9,  cREL.step(sREL, close, bar_index, 288, 10.0))
    P.set(10, vBL)
    P.set(11, cT3.step(close, 3.0))
    P.set(12, cT8.step(close, 8.0))
    P.set(13, vDM)
    P.set(14, c15.step(s15, close, bar_index, 288, 10.0))                     // [REV-12]
    W = array.from(w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15)
    num = 0.0
    den = 0.0
    for j = 0 to 14
        num += W.get(j) * P.get(j)
        den += math.abs(W.get(j))
    score := den > 0 ? num / den : 0.0
    want = pos
    if pos != 0 and score * pos < offThr
        want := 0
    if score >= onL                                                         // [REV-14]
        want := 1
    else if score <= -onS
        want := -1
    pos := want
    // [REV-10] poz içi zarar sınırı + düzenli geri giriş
    tgt = pos
    if tgt != prevT
        lockDir := 0
        prevT   := tgt
    wD = tgt
    if realDir != 0 and wD == realDir
        plNow = (close / rEp - 1.0) * realDir * 100.0
        if plNow <= -stopPct
            lockDir := realDir
            lockExt := close
            wD      := 0
        else if bar_index - rEb >= tsBars and plNow <= -tsLoss and adx15 < tsAdx   // [REV-13] yatayda takılı kalan poz
            lockDir := realDir
            lockExt := close
            wD      := 0
    if lockDir != 0 and wD == lockDir
        lockExt := lockDir > 0 ? math.min(lockExt, close) : math.max(lockExt, close)
        if (close / lockExt - 1.0) * lockDir * 100.0 >= reArm
            lockDir := 0
        else
            wD := 0
    if wD != 0 and wD != realDir and (gate or (wD == 1 and gateL) or (wD == -1 and gateS))   // [REV-13] + [REV-16]
        wD := 0
    if wD != realDir
        realDir := wD
        rEp     := close + syminfo.mintick * wD
        rEb     := bar_index

pUp = 1.0 / (1.0 + math.exp(-(-0.0247 + 0.7649 * score)))

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. EMİRLER
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
realPos = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
goLong  = barstate.isconfirmed and realDir == 1 and realPos != 1
goShort = barstate.isconfirmed and realDir == -1 and realPos != -1
goFlat  = barstate.isconfirmed and realDir == 0 and realPos != 0

if goLong
    strategy.entry("LONG", strategy.long, comment = "ENTER-LONG_BINANCE_BATUSDT_BOTADI_5M_BOTKODU")
else if goShort
    strategy.entry("SHORT", strategy.short, comment = "ENTER-SHORT_BINANCE_BATUSDT_BOTADI_5M_BOTKODU")
else if goFlat
    strategy.close_all(comment = "EXIT-ALL_BINANCE_BATUSDT_BOTADI_5M_BOTKODU")

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. GÖRSEL
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
plotshape(goLong, title = "LONG", style = shape.labelup, location = location.belowbar,
     color = color.lime, text = "LONG", textcolor = color.black, size = size.tiny)
plotshape(goShort, title = "SHORT", style = shape.labeldown, location = location.abovebar,
     color = color.red, text = "SHORT", textcolor = color.white, size = size.tiny)
plotshape(goFlat, title = "FLAT", style = shape.xcross, location = location.abovebar,
     color = color.gray, size = size.tiny)
bgcolor(strategy.position_size > 0 ? color.new(color.lime, 92) : strategy.position_size < 0 ? color.new(color.red, 92) : color.new(color.gray, 95))

plot(score, "Konsorsiyum Skoru", display = display.data_window)
plot(pos, "Konsorsiyum Yönü", display = display.data_window)
plot(realDir, "Gerçek Yön", display = display.data_window)
plot(lockDir, "Stop Kilidi", display = display.data_window)
